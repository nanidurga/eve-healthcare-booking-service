# Application
ENV=development
DEBUG=true

# Database
# PostgreSQL (production / docker-compose):
DATABASE_URL=postgresql+asyncpg://eve:eve@localhost:5432/eve_diagnostics
# SQLite fallback for local dev without Postgres:
# DATABASE_URL=sqlite+aiosqlite:///./eve.db

# Auth - CHANGE THIS IN ANY REAL DEPLOYMENT
JWT_SECRET=insecure-development-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Payment simulation
# Amounts whose paise/cents component equals this value are forced to FAIL.
PAYMENT_FAILURE_CENTS=13
